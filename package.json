{
  "name": "cadence",
  "private": true,
  "version": "0.4.0",
  "description": "Prompt-driven motion design studio: every scene is code, written to the millisecond, timed to the music, in every brand and format.",
  "license": "MIT",
  "author": "Arthur Monney <monneylobe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mckenziearts/cadence.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx bin/cadence.ts start",
    "dev": "tsx bin/cadence.ts start --dev",
    "cadence": "tsx bin/cadence.ts",
    "setup": "playwright install --only-shell chromium",
    "doctor": "tsx bin/cadence.ts doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "test:unit": "node --import tsx --test \"tests/runtime/**/*.test.ts\" \"tests/runtime/**/*.test.tsx\" \"tests/music/**/*.test.ts\" \"tests/server/**/*.test.ts\" \"tests/brands/**/*.test.tsx\" \"tests/templates/**/*.test.tsx\" tests/editor/helpers.test.tsx tests/editor/routing.test.ts",
    "test:e2e": "node --import tsx --test \"tests/e2e/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tabler/icons-react": "3.48.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "clsx": "2.1.1",
    "hono": "4.13.12",
    "lucide-react": "1.49.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "vite": "8.3.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
